<!-- SCROLL ANIMATION -->
<script>
window.addEventListener("scroll", () => {
    document.querySelectorAll(".card").forEach(card => {
        let pos = card.getBoundingClientRect().top;
        let screen = window.innerHeight;

        if(pos < screen - 100){
            card.style.opacity = "1";
            card.style.transform = "translateY(0)";
        }
    });
});
</script>


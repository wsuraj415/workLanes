<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>About | WorkLane</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
}

body {
    color: white;
    overflow-x: hidden;
}

/* VIDEO */
.video-bg {
    position: fixed;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
}

/* OVERLAY */
.overlay {
    background: rgba(0,0,0,0.75);
}

/* NAVBAR */
.navbar {
    display: flex;
    justify-content: space-between;
    padding: 20px 50px;
}

.navbar h2 {
    color: #ffb700;
    cursor: pointer;
    transition: 0.3s;
}

.navbar h2:hover {
    transform: scale(1.2);
    color: #fff;
    letter-spacing: 2px;
}

.navbar a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

.navbar a:hover {
    color: #ffb700;
}

/* HERO */
.hero {
    text-align: center;
    padding: 120px 20px 60px;
}

.hero h1 {
    font-size: 52px;
}

.hero p {
    max-width: 750px;
    margin: 20px auto;
    color: #ccc;
}

/* LINE ANIMATION */
.line-loader {
    width: 220px;
    height: 3px;
    background: linear-gradient(90deg, #ffb700, transparent);
    margin: 20px auto;
    animation: moveLine 2s linear infinite;
}

@keyframes moveLine {
    0% { transform: translateX(-100px); }
    100% { transform: translateX(100px); }
}

/* SECTION */
.section {
    padding: 80px 40px;
    text-align: center;
}

/* GRID */
.grid {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
}

/* CARD */
.card {
    width: 300px;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    overflow: hidden;
    transition: 0.5s;
    opacity: 0;
    transform: translateY(40px);
}

.card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    transition: 0.5s;
    filter: brightness(0.8);
}

.card:hover img {
    transform: scale(1.1);
    filter: brightness(1.1);
}

.card h3 {
    margin: 15px;
}

.card p {
    padding: 0 15px 20px;
    color: #ddd;
}

.card:hover {
    transform: translateY(-10px);
    background: #ffb700;
    color: black;
}

/* ABOUT FLEX */
.about-flex {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.about-text {
    max-width: 500px;
    text-align: left;
}

.about-text p {
    margin-top: 15px;
    color: #ccc;
    line-height: 1.6;
}

.about-img img {
    width: 350px;
    border-radius: 20px;
}

/* FOOTER */
.footer {
    text-align: center;
    padding: 30px;
    background: rgba(0,0,0,0.8);
    margin-top: 50px;
}
h2{

    padding-bottom: 18px;
}
.dev-card img {
    height: 20px;
    object-fit: cover;
    border-radius: 15px;
}
.card img {
    width: 100%;
    height: 320px;
    object-fit: cover;   
    /* background: #ffb700; */

    padding: 2px;          
}


</style>
</head>


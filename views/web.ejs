img:"https://i.pravatar.cc/100?img=5",
price:"₹5K–₹14K",
time:"3–6 Days",
rating:"4.9",
reviews:"132",
skills:["React","Redux","JS","UI"],
projects:"170+ Projects",
active:"Active 8 hours ago"
},
{
name:"Arjun Patel",
role:"Backend Developer",
img:"https://i.pravatar.cc/100?img=6",
price:"₹6K–₹16K",
time:"4–9 Days",
rating:"4.8",
reviews:"110",
skills:["Node","API","SQL","Auth"],
projects:"140+ Projects",
active:"Active 5 hours ago"
},
{
name:"Ritika Jain",
role:"WordPress Expert",
img:"https://i.pravatar.cc/100?img=7",
price:"₹3K–₹10K",
time:"2–5 Days",
rating:"4.7",
reviews:"75",
skills:["WordPress","SEO","Themes","Plugins"],
projects:"90+ Projects",
active:"Active 1 day ago"
},
{
name:"Dev Malhotra",
role:"Full Stack Engineer",
img:"https://i.pravatar.cc/100?img=8",
price:"₹8K–₹22K",
time:"5–12 Days",
rating:"5.0",
reviews:"160",
skills:["Next.js","Node","Cloud","DB"],
projects:"250+ Projects",
active:"Active 2 hours ago"
}
]; %>

       <% devs.forEach(dev => { %>

<div class="col-md-4">
    <div class="dev-card">

        <i class="fa-regular fa-heart save-icon"></i>

        <div class="dev-header">
            <img src="<%= dev.img %>">
            <div>
                <h5><%= dev.name %></h5>
                <p class="role"><%= dev.role %></p>
            </div>
        </div>

        <p class="dev-desc">
            High-quality web solutions with modern technologies and scalable architecture.
        </p>

        <!-- 🔥 INLINE INFO (FIXED ALIGNMENT) -->
       <div class="dev-info">

    <div class="price">
        💰 <%= dev.price %>
    </div>

    <div class="rating">
        ⭐ <%= dev.rating %> (<%= dev.reviews %> reviews)
    </div>

    <div class="status">
        ● <%= dev.active %>
    </div>

</div>

        <div class="work-done">
            <%= dev.projects %>
        </div>

        <!-- SKILLS -->
        <div class="skills">
            <% dev.skills.forEach(skill => { %>
                <span><%= skill %></span>
            <% }) %>
        </div>

        <!-- SOCIAL -->
        <div class="social">
            <i class="fa-brands fa-github"></i>
            <i class="fa-brands fa-linkedin"></i>
            <i class="fa-brands fa-whatsapp"></i>
            <i class="fa-solid fa-phone"></i>
        </div>

        <button class="hire-btn">Hire Now</button>

    </div>
</div>

<% }) %>
    </div>

</div>

<!-- ✅ FOOTER -->


</body>
</html>
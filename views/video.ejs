    skills: ["Reels", "Ads"],
    img: "https://i.pravatar.cc/100?img=15"
  },
  {
    name: "Vikram Rao",
    role: "Corporate Editor",
    price: "₹7K–₹20K",
    rating: "4.9",
    reviews: 250,
    active: "Active 8 hours ago",
    projects: "170+ Projects",
    skills: ["Corporate", "Branding"],

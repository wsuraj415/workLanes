%>

<!-- 🔥 PAGE HEADER -->
<section class="container text-center mt-5">
    <h1>Hire Top Video Editors</h1>
    <p class="text-muted">
        Find professional editors for reels, YouTube, ads & cinematic videos
    </p>
</section>

<!-- 🔥 CARDS -->
<section class="container mt-4">
    <div class="row">

        <% editors.forEach(dev => { %>

        <div class="col-md-4 mb-4">
            <div class="dev-card">

                <!-- ❤️ SAVE -->
                <i class="fa-regular fa-heart heart"></i>

                <!-- PROFILE -->
                <div class="dev-header">
                    <img src="<%= dev.img %>" class="profile">
                    <div>
                        <h4><%= dev.name %></h4>
                        <p><%= dev.role %></p>
                    </div>
                </div>

                <!-- DESC -->
                <p class="desc">
                    Professional video editing with high-quality output.
                </p>

                <!-- INFO -->
                <div class="dev-info">
                    <div class="price">💰 <%= dev.price %></div>
                    <div class="rating">⭐ <%= dev.rating %> (<%= dev.reviews %> reviews)</div>
                    <div class="status">● <%= dev.active %></div>
                </div>

                <!-- PROJECT -->
                <p class="projects"><%= dev.projects %></p>

                <!-- SKILLS -->
                <div class="skills">
                    <% dev.skills.forEach(skill => { %>
                        <span><%= skill %></span>
                    <% }) %>
                </div>

                <!-- SOCIAL -->
                <div class="social">
                    <i class="fa-brands fa-github"></i>
                    <i class="fa-brands fa-linkedin"></i>
                    <i class="fa-brands fa-whatsapp"></i>
                    <i class="fa-solid fa-phone"></i>
                </div>

                <!-- BUTTON -->
                <button class="btn btn-warning w-100 mt-3">Hire Now</button>

            </div>
        </div>

        <% }) %>

    </div>
</section>

<!-- 🔥 FOOTER -->


</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Video Editors | WorkLane</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/web.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    /* ❤️ HEART ICON */
.heart {
    position: absolute;
    top: 15px;
    right: 15px;
    font-size: 18px;
    color: #aaa;
    cursor: pointer;
    transition: 0.3s ease;
}

/* Hover effect */
.heart:hover {
    color: #ff4d4d;
    transform: scale(1.2);
}

/* Active (liked) */
.heart.active {
    color: #ff4d4d;
}

/* Card relative hona chahiye */
.dev-card {
    position: relative;
}
.text-muted {
    color: #aaa !important;
}
h1:hover {
    color: #ff4d4d;
    transition: 0.3s ease;
}
</style>
</head>
<body class="dark-bg">

<!-- 🔥 NAVBAR -->


<%

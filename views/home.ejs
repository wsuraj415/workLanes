<body class="dark-bg">

    <!-- 🔥 NAVBAR -->
    <nav class="navbar-custom">
        <div class="nav-inner">

            <!-- LEFT: ONLY LOGO -->
            <div class="nav-left">
                <h2 class="brand-logo">WORKLANE</h2>
            </div>

            <!-- RIGHT: ALL BUTTONS + ICONS -->
            <div class="nav-right">

                <!-- MENU BUTTONS -->
                <div class="nav-links">
                    <a href="#">Browse Jobs</a>
                    <a href="#">Post Job</a>
                    <a href="#">My Work</a>
                    <a href="/about">About Us</a>
                    <a href="#">Messages</a>
                </div>

                <!-- NOTIFICATION -->
                <div class="notification">
                    <i class="fa-solid fa-bell"></i>
                    <span class="badge">+1</span>
                </div>

                <!-- PROFILE -->
                <img src="https://i.pravatar.cc/40" class="profile-img">

            </div>

        </div>
    </nav>
    <!-- 🎥 HERO -->
    <section class="hero">

        <video autoplay muted loop class="hero-video">
            <source src="/cover1.mp4" type="video/mp4">

        </video>

        <!-- DARK OVERLAY -->

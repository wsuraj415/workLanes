                    <p>Hire skilled freelancers instantly and accelerate your projects.</p>
                </div>

                <div class="feature-card">
                    <i class="fa-solid fa-shield-halved"></i>
                    <h4>Secure Payments</h4>
                    <p>Safe and reliable transactions with full protection.</p>
                </div>

                <div class="feature-card">
                    <i class="fa-solid fa-star"></i>
                    <h4>Top Talent</h4>
                    <p>Work with verified professionals across multiple domains.</p>
                </div>

            </div>

        </div>

    </section>
    <!-- 🔥 FOOTER -->
    <footer class="footer">

        <div class="footer-container">

            <!-- LEFT: BRAND -->
            <div class="footer-brand">
                <h2>WORKLANE</h2>
                <p>
                    Connecting businesses with top freelancers worldwide.
                    Fast, secure, and reliable platform for modern work.
                </p>

                <div class="social-icons">
                    <i class="fab fa-facebook-f"></i>
                    <i class="fab fa-twitter"></i>
                    <i class="fab fa-linkedin-in"></i>
                    <i class="fab fa-instagram"></i>
                </div>
            </div>

            <!-- LINKS -->
            <div class="footer-links">
                <h4>Company</h4>
                <a href="/about">About</a>
                <a href="#">Careers</a>
                <a href="#">Blog</a>
            </div>

            <div class="footer-links">
                <h4>Support</h4>
                <a href="#">Help Center</a>
                <a href="#">Terms</a>
                <a href="#">Privacy</a>
            </div>

            <div class="footer-links">
                <h4>Explore</h4>
                <a href="#">Browse Jobs</a>
                <a href="#">Post a Job</a>
                <a href="#">Freelancers</a>
            </div>

            <!-- NEWSLETTER -->
            <div class="footer-newsletter">

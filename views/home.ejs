    <!-- 🔥 FREELANCE MARKETPLACE -->


    <!-- 🔥 CARDS GRID -->
    <section class="marketplace">

        <div class="container mt-5">

            <h2 class="section-title mb-4">Explore Services</h2>

            <!-- SEARCH -->
            <div class="market-search mb-3">
                <input type="text" placeholder="Search services...">
                <button>Search</button>
            </div>

            <!-- CATEGORY -->
            <div class="category-bar mb-3">
                <button>Web Dev</button>
                <button>App Dev</button>
                <button>Video Editing</button>
                <button>UI/UX Design</button>
                <button>AI</button>
                <button>Web Dev</button>
                <button>App Dev</button>
                <button>Video Editing</button>
                <button>Web Dev</button>
                <button>App Dev</button>
                <button>AI</button>
            </div>

            <!-- FILTER -->
            <div class="filter-bar mb-4">
                <button>Service Options</button>
                <button>Budget</button>
                <button>Delivery Time</button>
                <button>Rating</button>

            </div>

            <!-- 🔥 CARDS -->
            <div class="row">

                <% services.forEach(service=> { %>

                    <div class="col-md-3 mb-4">
                        <div class="service-card-2">

                            <img src="<%= service.img %>">

                            <div class="card-body">

                                <h5>
                                    <%= service.title %>
                                </h5>
                                <p class="price">
                                    <%= service.price %>
                                </p>
                                <p class="desc">
                                    <%= service.desc %>
                                </p>
                                <div class="users">
                                    <img src="https://i.pravatar.cc/30?img=1">
                                    <img src="https://i.pravatar.cc/30?img=2">
                                    <img src="https://i.pravatar.cc/30?img=3">
                                    <span>12+</span>
                                </div>

                                <a href="<%= service.link %>" class="details-btn">
                                    View Details
                                </a>
                            </div>

                        </div>
                    </div>

                    <% }) %>

            </div>

        </div>

    </section>

    </section>








    <!-- 🚀 CTA -->
    <section class="container text-center mt-5">
        <!-- <h2>Start your freelancing journey today</h2> -->
        <!-- <button class="btn btn-warning mt-3 px-5">Join Now</button> -->
    </section>
    <!-- review -->
    <section class="stats-section">

        <div class="container">

            <!-- HEADING -->
            <h2 class="section-title">Why WorkLane?</h2>

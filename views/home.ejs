        <div class="hero-content text-center">
            <h1>Hire Top Freelancers</h1>
            <p>Get your work done faster with skilled professionals</p>

            <!-- 🔍 SEARCH FIXED -->
            <div class="search-container mt-4">
                <input autofocus type="text" placeholder="Search services...">
                <button>Explore Jobs</button>
            </div>
        </div>

    </section>


